PORT=3000
HOST=127.0.0.1
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
DEMO_MODE=true
PGLITE_DIR=

# Leave DATABASE_URL empty to use persistent embedded PostgreSQL locally.
# Set DATABASE_URL to use a PostgreSQL server instead.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/pos_store
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_store
DB_USER=postgres
DB_PASSWORD=
# For a new empty store, use DEMO_MODE=false and set these credentials:
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Gerald
# Production requires DATABASE_URL, SESSION_SECRET, DEMO_MODE=false,
# and APP_ORIGIN=https://your-domain.example.
# On Render also set NODE_ENV=production and HOST=0.0.0.0.
# APP_ORIGIN is the Vercel production origin, e.g. https://your-pos.vercel.app.
# Use the Render Postgres Internal Database URL for DATABASE_URL.
# See README.md for the complete Render + Vercel setup.
